title: BlueBattle — 3D 双人格斗对战游戏
size: [1280, 720]
theme:
  colors:
    primary: "#0EA5E9"
    secondary: "#64748B"
    accent: "#F59E0B"
    background: "#0F172A"
    text: "#F8FAFC"
    card: "#1E293B"
    border: "#334155"
    highlight: "#38BDF8"
  textStyles:
    title:
      fontSize: 32
      color: "$text"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.2
    subtitle:
      fontSize: 22
      color: "$primary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.3
    body:
      fontSize: 18
      color: "$text"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.6
    caption:
      fontSize: 14
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
    accent:
      fontSize: 20
      color: "$accent"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
pages:
  # 结构对齐 outline.md：项目概述 → 四大技术亮点 → 架构细节 → 总结
  - cover
  - toc
  - chapter-overview
  - project-intro
  - chapter-highlights
  - highlights-overview
  - mass-actorcomponent
  - gamemode-experience
  - ui-commonui-mvvm
  - melee-sweep
  - chapter-architecture
  - combat-dataflow
  - chapter-summary
  - summary
  - final
